#!/usr/bin/env php
<?php

declare(strict_types=1);

use GalahadXVI\OctaneGuard\Guard;
use GalahadXVI\OctaneGuard\GuardException;
use GalahadXVI\OctaneGuard\State;

if ($argc === 2 && $argv[1] === '--help') {
    echo <<<'HELP'
Octane Guard (alpha)

Run through Supervisor:
  php8.4 vendor/bin/octane-guard --run --app-dir=/absolute/site --state-dir=/absolute/state

Reset the failure count after fixing the cause and stopping the Forge process:
  php8.4 vendor/bin/octane-guard --reset --app-dir=/absolute/site --state-dir=/absolute/state

Requirements:
  Linux CLI PHP with pcntl, posix, and Swoole. Foreground Swoole only.
  The guard starts Octane at 127.0.0.1:8000 using the same PHP executable.
  State must be outside the application, owned by its user, with mode 0700.
  Keep the same state directory and stable application path across deployments.

Required settings on the existing Octane Supervisor program:
  numprocs=1
  autorestart=unexpected
  exitcodes=0,78,255
  startsecs=1
  startretries=3
  stopwaitsecs=20
  stopsignal=TERM
  stopasgroup=true
  killasgroup=true

Stops take 10 seconds and end with SIGKILL of the guard's own process group.
Three failed runs stop automatic recovery until --reset. Deploys and reboots
never reset the count. Normal requested stops do not count as failures.

The guard does not detect HTTP hangs or clean up pre-existing orphan processes.
See README.md for setup and limits. Real Octane/Swoole validation is still required
before production use. Installing this package does not change server settings.
HELP;
    echo PHP_EOL;
    exit(0);
}

require_once __DIR__.'/../src/guard-exception.php';

try {
    $arguments = array_slice($argv, 1);
    $operation = array_shift($arguments);
    $options = [];

    if (!in_array($operation, ['--run', '--reset'], true))
        throw new GuardException('Choose --run or --reset. Use --help for usage.');

    foreach ($arguments as $argument) {
        if (!preg_match('/^--(app-dir|state-dir)=(.+)$/D', $argument, $matches) || isset($options[$matches[1]]))
            throw new GuardException('Pass --app-dir and --state-dir once each, using --name=/absolute/path.');

        $options[$matches[1]] = $matches[2];
    }

    if (count($options) !== 2)
        throw new GuardException('Both --app-dir=/absolute/site and --state-dir=/absolute/state are required.');

    if (PHP_SAPI !== 'cli' || PHP_OS_FAMILY !== 'Linux' || !extension_loaded('pcntl') || !extension_loaded('posix'))
        throw new GuardException('Linux CLI PHP with pcntl and posix is required.');

    require_once __DIR__.'/../src/state.php';
    require_once __DIR__.'/../src/guard.php';

    if ($operation === '--run') {
        if (getenv('SUPERVISOR_ENABLED') !== '1')
            throw new GuardException('Run mode must be started directly by Supervisor. Use the configured Forge process.');

        if (!extension_loaded('swoole'))
            throw new GuardException('Swoole is missing from this PHP executable.');

        if (!is_file($options['app-dir'].'/artisan'))
            throw new GuardException('The application directory must contain an artisan file.');
    }

    $boot_id = @file_get_contents('/proc/sys/kernel/random/boot_id');

    if ($boot_id === false)
        throw new GuardException('Cannot read the Linux boot identifier; refusing to trust stored process IDs.');

    $state = new State($options['state-dir'], $options['app-dir'], trim($boot_id));

    if ($operation === '--reset') {
        $state->acquire();
        $record = $state->read();

        if ($record['pgid'] !== null && !Guard::groupIsAbsent($record['pgid']))
            throw new GuardException('The previous process group still exists or cannot be inspected. No reset or cleanup performed.');

        $record['launches'] = 0;
        $state->save($record);
        fwrite(STDOUT, "[octane-guard] Failure count reset. Start the existing Forge Octane process when ready.\n");
        exit(0);
    }

    $guard = new Guard($state, [
        PHP_BINARY,
        $options['app-dir'].'/artisan',
        'octane:start',
        '--server=swoole',
        '--host=127.0.0.1',
        '--port=8000',
        '--no-interaction',
    ], $options['app-dir']);

    exit($guard->run());
} catch (GuardException $exception) {
    fwrite(STDERR, '[octane-guard] REFUSED: '.$exception->getMessage().PHP_EOL);
    exit(78);
} catch (Throwable) {
    fwrite(STDERR, "[octane-guard] REFUSED: unexpected guard failure. Check the daemon log before restarting.\n");
    exit(78);
}
