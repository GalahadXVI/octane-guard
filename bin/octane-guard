#!/usr/bin/env php
<?php

declare(strict_types=1);

use GalahadXVI\OctaneGuard\Blocked;
use GalahadXVI\OctaneGuard\Guard;
use GalahadXVI\OctaneGuard\GuardException;
use GalahadXVI\OctaneGuard\State;

if ($argc === 2 && $argv[1] === '--help') {
    echo <<<'HELP'
Octane Guard (alpha)

Forge background-process command:
  /usr/bin/php8.4 /absolute/site/vendor/bin/octane-guard --run --app-dir=/absolute/site

Use the site's user and working directory. Set Processes=1, Start=1 second,
Stop=20 seconds, Stop Signal=SIGTERM. Keep Forge's automatic restart enabled.
Replace the existing Octane command; do not run a second Octane entry.

The guard automatically creates private state under the operating-system user's
home: .octane-guard/<hash-of-app-path>. Keep the same --app-dir across deployments.
Optional --state-dir=/absolute/state preserves an existing installation's location.
Never delete or change state to bypass a blocked guard.

If blocked, the guard stays alive without retrying or launching Octane. The Forge
process can appear running while Octane is down. See its log for the reason and
five-minute reminders. Stop, fix the cause, then reset the count if exhausted:
  php8.4 /absolute/site/vendor/bin/octane-guard --reset --app-dir=/absolute/site
Use the same --state-dir for reset if you supplied one when running.

Requirements: Linux CLI PHP with pcntl, posix, and Swoole. Foreground Swoole only.
Octane starts at 127.0.0.1:8000 using the same PHP executable.
Normal stops take 10 seconds and end with SIGKILL of the guard's own process group.
Three failed runs block recovery. Deploys/reboots/restarts never reset the count.
The guard does not detect HTTP hangs or clean up pre-existing orphan processes.
Real Octane/Swoole validation is still required before production use.
HELP;
    echo PHP_EOL;
    exit(0);
}

require_once __DIR__.'/../src/guard-exception.php';
require_once __DIR__.'/../src/blocked.php';

$operation = $argv[1] ?? null;
$supervised_run = getenv('SUPERVISOR_ENABLED') === '1' && $operation !== '--reset';

try {
    $arguments = array_slice($argv, 1);
    $operation = array_shift($arguments);
    $options = [];

    if (!in_array($operation, ['--run', '--reset'], true))
        throw new GuardException('Choose --run or --reset. Use --help for usage.');

    foreach ($arguments as $argument) {
        if (!preg_match('/^--(app-dir|state-dir)=(.+)$/D', $argument, $matches) || isset($options[$matches[1]]))
            throw new GuardException('Pass each path once, using --name=/absolute/path. Only --app-dir and --state-dir are supported.');

        $options[$matches[1]] = $matches[2];
    }

    if (!isset($options['app-dir']))
        throw new GuardException('--app-dir=/absolute/site is required.');

    if (PHP_SAPI !== 'cli' || PHP_OS_FAMILY !== 'Linux' || !extension_loaded('pcntl') || !extension_loaded('posix'))
        throw new GuardException('Linux CLI PHP with pcntl and posix is required.');

    require_once __DIR__.'/../src/state.php';
    require_once __DIR__.'/../src/guard.php';

    $options['app-dir'] = rtrim($options['app-dir'], '/');

    if (!isset($options['state-dir']))
        $options['state-dir'] = State::defaultDirectory($options['app-dir']);

    if ($operation === '--run') {
        if (!$supervised_run)
            throw new GuardException('Run mode must be started directly by Supervisor. Use the configured Forge process.');

        if (!extension_loaded('swoole'))
            throw new GuardException('Swoole is missing from this PHP executable.');

        if (!is_file($options['app-dir'].'/artisan'))
            throw new GuardException('The application directory must contain an artisan file.');

        State::provisionDirectory($options['state-dir'], $options['app-dir']);
    }

    $boot_id = @file_get_contents('/proc/sys/kernel/random/boot_id');

    if ($boot_id === false)
        throw new GuardException('Cannot read the Linux boot identifier; refusing to trust stored process IDs.');

    $state = new State($options['state-dir'], $options['app-dir'], trim($boot_id));

    if ($operation === '--reset') {
        $state->acquire();
        $record = $state->read();

        if ($record['pgid'] !== null && !Guard::groupIsAbsent($record['pgid']))
            throw new GuardException('The previous process group still exists or cannot be inspected. No reset or cleanup performed.');

        $record['launches'] = 0;
        $state->save($record);
        fwrite(STDOUT, "[octane-guard] Failure count reset. Start the Forge Octane process when ready.\n");
        exit(0);
    }

    fwrite(STDERR, '[octane-guard] State directory: '.json_encode($options['state-dir'], JSON_UNESCAPED_SLASHES).PHP_EOL);

    $guard = new Guard($state, [
        PHP_BINARY,
        $options['app-dir'].'/artisan',
        'octane:start',
        '--server=swoole',
        '--host=127.0.0.1',
        '--port=8000',
        '--no-interaction',
    ], $options['app-dir']);

    exit($guard->run());
} catch (GuardException $exception) {
    if ($supervised_run)
        exit(Blocked::wait($exception->getMessage()));

    fwrite(STDERR, '[octane-guard] REFUSED: '.$exception->getMessage().PHP_EOL);
    exit(78);
} catch (Throwable) {
    if ($supervised_run)
        exit(Blocked::wait('Unexpected guard failure. Inspect the daemon log and installation before restarting.'));

    fwrite(STDERR, "[octane-guard] REFUSED: unexpected guard failure. Check the daemon log before restarting.\n");
    exit(78);
}
